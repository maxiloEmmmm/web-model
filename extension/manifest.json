{
  "manifest_version": 3,
  "name": "web-model Bridge",
  "version": "0.1.0",
  "description": "Bridge supported web chat tabs to the local web-model server.",
  "permissions": [
    "scripting",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://chat.qwen.ai/*",
    "https://chatgpt.com/*",
    "https://gemini.google.com/*",
    "https://www.kimi.com/*",
    "https://yuanbao.tencent.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.kimi.com/*"
      ],
      "js": [
        "helper.js",
        "providers/shared.js",
        "providers/qwen.js",
        "providers/chatgpt.js",
        "providers/gemini.js",
        "providers/kimi.js",
        "providers/yuanbao.js",
        "providers.js",
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "web-model",
    "default_popup": "popup.html"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "helper.js",
        "page-hook.js"
      ],
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.qwen.ai/*",
        "https://gemini.google.com/*",
        "https://www.kimi.com/*",
        "https://yuanbao.tencent.com/*"
      ]
    }
  ]
}
